# =============================================================================
# CloudboyX Predict & Forecasting Engine - Environment Configuration
# =============================================================================

# GEMINI_API_KEY: (Recommended) Google Gemini API Key for live AI forecasting,
# multi-agent dialectic debate synthesis, 7-day sentiment NLP analysis, and PredictaBot guide.
# Get a free key at: https://aistudio.google.com/app/apikey
# Note: Also accepts alias "API_KEY" or "GOOGLE_GENAI_API_KEY".
# If omitted, the application runs seamlessly in calibrated standalone baseline mode with zero crashes.
GEMINI_API_KEY=""

# PORT: The HTTP port to bind the server to (default: 3000).
# Cloud hosting providers (Render, Railway, Heroku, Cloud Run, Fly.io) set this automatically.
PORT=3000

# NODE_ENV: Set to "production" in production environments or "development" locally.
NODE_ENV=development

# APP_URL: Optional canonical URL where this applet is hosted (e.g. https://your-app.onrender.com).
APP_URL="http://localhost:3000"

# (Optional) External Data API keys for scripts/ingest_and_model.py Python pipeline
# NEWS_API_KEY=""
# ALPHA_VANTAGE_KEY=""
